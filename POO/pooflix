class Login_usuario:
    def __init__(self, nome, email, senha):
        self.nome = nome
        self.email = email
        self.senha = senha

class Filme:
    def __init__(self, titulo, duracao, genero, classificacao, diretor):
        self.titulo = titulo
        self.duracao = duracao
        self.genero = genero
        self.classificacao = classificacao
        self.diretor = diretor

class Serie:
    def __init__(self, titulo, genero, classificacao, temporadas, episodios):
        self.titulo = titulo
        self.genero = genero
        self.classificacao = classificacao
        self.temporada = temporadas
        self.episodio = episodios


