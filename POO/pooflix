class Login_usuario:
    def __init__(self, nome, email, senha):
        self.nome = nome
        self.email = email
        self.senha = senha

    def exibir_dados(self):
        print(f"Nome: {self.nome}")
        print(f"E-mail: {self.email}")
        print(f"Senha: {self.senha}")


class Filme:
    def __init__(self, titulo, duracao, genero, classificacao, diretor):
        self.titulo = titulo
        self.duracao = duracao
        self.genero = genero
        self.classificacao = classificacao
        self.diretor = diretor

    def exibir_dados(self):
        print(f"Título: {self.titulo}")
        print(f"Duração: {self.duracao}")
        print(f"Gênero: {self.genero}")
        print(f"Classificação: {self.classificacao}")
        print(f"Diretor: {self.diretor}")


class Serie:
    def __init__(self, titulo, genero, classificacao, temporadas, episodios):
        self.titulo = titulo
        self.genero = genero
        self.classificacao = classificacao
        self.temporada = temporadas
        self.episodio = episodios



